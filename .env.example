# Environment Configuration for Hendrix Cargo & Logistics

# Application Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL for Production/Render, SQLite fallback for local test/dev)
# PostgreSQL example: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hendrix_cargo"

# Security & Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="hendrix_secure_jwt_secret_change_in_production_2026_xyz"
SESSION_SECRET="hendrix_secure_session_secret_change_in_production_2026_abc"

# Admin Initial Setup (Optional: used when running npm run seed:admin)
INITIAL_ADMIN_EMAIL="admin@hendrixcargo.com"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="ChangeMeSecurePassword2026!"

# Allowed CORS Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000"

# Public App Info
VITE_API_URL=""
