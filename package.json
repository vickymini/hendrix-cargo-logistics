{
  "name": "hendrix-cargo-logistics",
  "version": "1.0.0",
  "description": "Production-ready website and shipment management system for Hendrix Cargo & Logistics",
  "private": true,
  "main": "server/dist/server.js",
  "scripts": {
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/server.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "npm test --prefix server",
    "seed:admin": "npm run seed:admin --prefix server",
    "seed:demo": "npm run seed:demo --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:push": "npm run prisma:push --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
